{
  "id": "cyberpunk-remaster",
  "title": "SF2E Cyberpunk Remaster",
  "description": "Cyberpunk equipment, netrunning, full-body conversion, cyberware management and NPC generation for Starfinder Second Edition.",
  "version": "2.8.31",
  "authors": [
    {
      "name": "Ogorodnik"
    }
  ],
  "compatibility": {
    "minimum": "14.360",
    "verified": "14.365",
    "maximum": "14"
  },
  "relationships": {
    "requires": [
      {
        "id": "pf2e-anachronism",
        "type": "module",
        "manifest": "https://raw.githubusercontent.com/foundryvtt/pf2e/v14-dev/module.pf2e-anachronism.json",
        "compatibility": {
          "minimum": "2.2.0"
        }
      }
    ],
    "recommends": [
      {
        "id": "pf2e-ru",
        "type": "module",
        "manifest": "https://gitlab.com/gnuraco/pf2r/-/releases/permalink/latest/downloads/module.json",
        "compatibility": {
          "minimum": "2.2.0"
        }
      },
      {
        "id": "pf2e-toolbelt",
        "type": "module",
        "manifest": "https://raw.githubusercontent.com/reonZ/pf2e-toolbelt/master/module.json",
        "compatibility": {
          "minimum": "3.50.0"
        }
      }
    ],
    "systems": [
      {
        "id": "sf2e",
        "type": "system",
        "manifest": "https://raw.githubusercontent.com/foundryvtt/pf2e/v14-dev/system.sf2e.json",
        "compatibility": {
          "minimum": "1.4.0"
        }
      }
    ]
  },
  "esmodules": [
    "runtime/cyberware-runtime.mjs",
    "runtime/implant-creator.mjs",
    "runtime/item-sheet-enhancements.mjs",
    "forge/forge-runtime.mjs",
    "runtime/neuro-archive-runtime.mjs"
  ],
  "styles": [
    {
      "src": "styles/cyberware.css"
    },
    {
      "src": "styles/sf2e-upgrades.css"
    },
    {
      "src": "styles/cyberpunk-forge.css"
    },
    {
      "src": "styles/neuro-archive.css"
    },
    {
      "src": "styles/implant-creator.css"
    },
    {
      "src": "styles/cyberpunk-windows.css"
    }
  ],
  "packs": [
    {
      "name": "cyberpunk-items",
      "label": "SF2E Cyberpunk Items",
      "path": "packs/cyberpunk-items",
      "type": "Item",
      "system": "sf2e",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      },
      "flags": {}
    },
    {
      "name": "cyberpunk-journals",
      "label": "SF2E Cyberpunk Journals",
      "path": "packs/cyberpunk-journals",
      "type": "JournalEntry",
      "system": "sf2e",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      },
      "flags": {}
    },
    {
      "name": "cyberpunk-macros",
      "label": "SF2E Cyberpunk Macros",
      "path": "packs/cyberpunk-macros",
      "type": "Macro",
      "system": "sf2e",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      },
      "flags": {}
    }
  ],
  "packFolders": [
    {
      "name": "SF2E Cyberpunk",
      "sorting": "m",
      "color": "#850000",
      "packs": [
        "cyberpunk-items",
        "cyberpunk-journals",
        "cyberpunk-macros"
      ]
    }
  ],
  "flags": {
    "cyberpunk-remaster": {
      "pf2e-homebrew": {
        "classTraits": {
          "netrunner": {
            "label": "Нетраннер",
            "description": "Черты, фиты и программы класса Нетраннер."
          }
        },
        "equipmentTraits": {
          "neironn-uskoritell": {
            "label": "Нейронный ускоритель",
            "description": "Имплант напрямую взаимодействует с нервной системой и требует монопольного доступа к нейронным интерфейсам. Персонаж может иметь не более одного импланта с этим признаком одновременно."
          },
          "pkt": {
            "label": "ПКТ",
            "description": "Этот имплант можно установить только в Полную Конверсию Тела."
          }
        },
        "spellTraits": {
          "ustroystvo": {
            "label": "Устройство",
            "description": "У цели должна быть любая кибернетика или сетевое устройство. Если рядом с этим признаком указан конкретный тип, требуется именно он; несколько признаков означают, что нужны все."
          },
          "ustroystvo-neyro": {
            "label": "Устройство:Нейро",
            "description": "У цели должен быть нейролинк или нейроинтерфейс."
          },
          "ustroystvo-optika": {
            "label": "Устройство:Оптика",
            "description": "У цели должны быть киберглаза, оптический имплант или AR-интерфейс."
          },
          "ustroystvo-audio": {
            "label": "Устройство:Аудио",
            "description": "У цели должны быть киберуши или иной аудиоимплант."
          },
          "ustroystvo-kiberruka": {
            "label": "Устройство:Киберрука",
            "description": "У цели должна быть кибернетическая рука."
          },
          "ustroystvo-kibernoga": {
            "label": "Устройство:Кибернога",
            "description": "У цели должна быть кибернетическая нога."
